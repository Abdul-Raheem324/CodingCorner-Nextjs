# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codeeditor?retryWrites=true&w=majority

# JWT Secret for authentication tokens
JWT_SECRET_KEY=your_jwt_secret_key_here

# Socket.IO Server URL (Frontend connects to this)
# In development: http://localhost:3001
# In production: https://your-socket-server.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# RapidAPI Key for Judge0 Code Execution
RAPIDAPI_KEY=your_rapidapi_key_here

# Frontend URL (Used by Socket.IO server to allow CORS)
# In development: http://localhost:3000
# In production: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:3000

# Server Port (Default is 3001 for socket server, 3000 for next app)
PORT=3001
NODE_ENV=production
